# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Path prefix when hosted on GitHub Pages (set automatically by the deploy workflow)
NEXT_PUBLIC_BASE_PATH=

# Contact form: optional form service endpoint (e.g. https://formspree.io/f/xxxxxxx).
# On GitHub Pages, set it as the repository variable CONTACT_FORM_ENDPOINT.
# When empty, the form opens the visitor's email app addressed to greekwavetech@zohomail.in.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
